#!/opt/research-agent-venv/bin/python
"""幂等启动固定 websockify 画面桥；不接受端口、目标或静态目录参数。"""

from __future__ import annotations

import fcntl
import os
import signal
import socket
import subprocess
import time
from pathlib import Path

_RUNTIME_DIR = Path("/tmp/research-agent-browser")
_LISTEN_PORT = 6080


def _command() -> list[str]:
    """返回平台固定命令，不启用 web root、目录列表、录制或动态目标。"""
    return [
        "/opt/research-agent-venv/bin/websockify",
        "--timeout",
        "300",
        "--idle-timeout",
        "60",
        "--heartbeat",
        "30",
        "--log-file",
        str(_RUNTIME_DIR / "websockify.log"),
        "0.0.0.0:6080",
        "127.0.0.1:5901",
    ]


def _port_is_open(port: int) -> bool:
    with socket.socket() as client:
        client.settimeout(0.2)
        return client.connect_ex(("127.0.0.1", port)) == 0


def _read_pid(pid_file: Path) -> int | None:
    try:
        pid = int(pid_file.read_text(encoding="ascii"))
        os.kill(pid, 0)
    except (FileNotFoundError, ProcessLookupError, PermissionError, ValueError):
        return None
    return pid


def _stop_process(pid: int) -> None:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.05)
    os.kill(pid, signal.SIGKILL)


def _start_process(command: list[str], pid_path: Path) -> None:
    process = subprocess.Popen(
        command,
        cwd="/workspace",
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        close_fds=True,
        start_new_session=True,
    )
    pid_path.write_text(str(process.pid), encoding="ascii")
    pid_path.chmod(0o600)
    deadline = time.monotonic() + 20
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError("Browser proxy 启动失败")
        if _port_is_open(_LISTEN_PORT):
            return
        time.sleep(0.1)
    process.terminate()
    raise TimeoutError("Browser proxy 启动超时")


def ensure_browser_proxy() -> int:
    """在进程锁内幂等收敛到固定 6080→5901 websockify。"""
    _RUNTIME_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_path = _RUNTIME_DIR / "websockify.lock"
    pid_path = _RUNTIME_DIR / "websockify.pid"
    with lock_path.open("a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        pid = _read_pid(pid_path)
        port_open = _port_is_open(_LISTEN_PORT)
        if pid is None and port_open:
            raise RuntimeError("Browser proxy 固定端口已被未知进程占用")
        if pid is not None and port_open:
            return 0
        if pid is not None:
            _stop_process(pid)
        _start_process(_command(), pid_path)
        return 0


def main() -> int:
    if len(os.sys.argv) != 1:
        raise ValueError("Browser proxy 不接受参数")
    return ensure_browser_proxy()


if __name__ == "__main__":
    os.umask(0o077)
    raise SystemExit(main())
