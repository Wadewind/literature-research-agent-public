# 本地基础设施（与 deploy/compose/compose.yml 一致）
AGENT_APP_NAME="Literature Review Agent"
AGENT_DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5432/agent_service
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_DEV_ACTOR_ID=dev-user
AGENT_STORAGE_ROOT=data/storage
# API 与 Worker 的 Python 日志等级：DEBUG/INFO/WARNING/ERROR/CRITICAL。
AGENT_LOG_LEVEL=INFO
# Worker Prometheus endpoint 固定绑定 127.0.0.1；0 表示关闭。
AGENT_WORKER_METRICS_PORT=8001
# 仅本地诊断使用；不要在公网环境把它当作认证或安全开关。
# AGENT_DEBUG=false
# SQLAlchemy SQL echo 独立于 AGENT_DEBUG，默认关闭；仅排查数据库时临时开启。
# AGENT_DATABASE_ECHO=false

# 上传、解析和可靠执行。以下均为当前默认值，通常无需修改。
# AGENT_MAX_UPLOAD_SIZE_BYTES=52428800
# AGENT_PARSER_TIMEOUT_SECONDS=300
# AGENT_JOB_TIMEOUT_SECONDS=1800
# AGENT_WORKER_LEASE_SECONDS=600
# AGENT_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
# AGENT_WORKER_RECONCILE_INTERVAL_SECONDS=30
# AGENT_MAX_RUN_ATTEMPTS=3
# AGENT_OUTBOX_POLL_INTERVAL_SECONDS=1
# AGENT_OUTBOX_MAX_ATTEMPTS=10
# AGENT_OUTBOX_DISPATCH_BATCH_SIZE=20

# 默认 Fake 模式：不联网、不产生模型费用。
AGENT_PARSER_BACKEND=fake
AGENT_EMBEDDING_BACKEND=fake
AGENT_CHAT_BACKEND=fake
AGENT_ARXIV_BACKEND=fake
AGENT_RESEARCH_RUNTIME_BACKEND=fake

# 真实 Parser 通常首次运行需要联网下载 Docling 模型。
# AGENT_PARSER_BACKEND=docling
# HF_HUB_OFFLINE=1

# 真实 Embedding（Base URL 是 API 根路径，Adapter 会追加 /embeddings）。
# AGENT_EMBEDDING_BACKEND=openai_compatible
# AGENT_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AGENT_EMBEDDING_API_KEY=
# AGENT_EMBEDDING_MODEL=embedding-3
# AGENT_EMBEDDING_DIMENSIONS=1024
# AGENT_EMBEDDING_BATCH_SIZE=32

# 真实 Chat。Provider 不支持 response_format=json_schema 时设为 false；官方 DeepSeek V4 默认关闭 thinking。
# AGENT_CHAT_BACKEND=openai_compatible
# AGENT_CHAT_BASE_URL=https://api.deepseek.com
# AGENT_CHAT_API_KEY=
# AGENT_CHAT_MODEL=deepseek-v4-flash
# AGENT_CHAT_JSON_SCHEMA_SUPPORTED=false
# AGENT_CHAT_THINKING_MODE=disabled
# AGENT_CHAT_REASONING_EFFORT=low

# PDF 索引与 RAG Profile。修改 Chunk 参数会产生新的 profile hash/ChunkSet，
# 不会原地改写已经完成的索引；Embedding 维度当前必须保持 1024。
# AGENT_CHUNK_MAX_TOKENS=512
# AGENT_CHUNK_OVERLAP_TOKENS=64
# AGENT_RETRIEVAL_TOP_K=20
# AGENT_RETRIEVAL_PER_PAPER_LIMIT=8
# AGENT_RETRIEVAL_TOKEN_BUDGET=3000
# AGENT_ANSWER_MAX_OUTPUT_TOKENS=4096

# 真实 Research Agent。该 Provider 与上面的 RAG/Review Chat 独立；只有显式启用才读取 Key 并产生费用。
# 模型当前固定为 deepseek-v4-flash；thinking 默认关闭，仅允许在 AGENT_DEBUG=true 时调试开启。
# AGENT_RESEARCH_RUNTIME_BACKEND=deep_agents
# AGENT_RESEARCH_MODEL_BASE_URL=https://api.deepseek.com
# AGENT_RESEARCH_MODEL_API_KEY=
# AGENT_RESEARCH_MODEL=deepseek-v4-flash
# AGENT_RESEARCH_MODEL_MAX_OUTPUT_TOKENS=4096
# AGENT_RESEARCH_MODEL_THINKING_MODE=disabled
# AGENT_RESEARCH_MODEL_REASONING_EFFORT=low
# OpenSandbox server 需独立启动；普通 compose 不会启动它。镜像由
# sandbox/research-agent/Dockerfile 构建，运行时固定为平台配置，用户请求不能覆盖。
# 只接受 @sha256:... 不可变引用；latest、phase 标签等可变引用会在启动时被拒绝。
# AGENT_RESEARCH_SANDBOX_DOMAIN=127.0.0.1:8080
# AGENT_RESEARCH_SANDBOX_PROTOCOL=http
# AGENT_RESEARCH_SANDBOX_API_KEY=
# AGENT_RESEARCH_SANDBOX_IMAGE=agent-service/research-agent-sandbox@sha256:8ded4a3cfb5603efac3e297a09f79f4bdef798379728eeb96d563ae8f99f40d1

# 真实 arXiv 官方 API/PDF；默认 fake 不创建 HTTP 客户端。
# AGENT_ARXIV_BACKEND=httpx

# RAG/Review Chat 与 Research Agent 共用的 Provider 调用超时/Adapter 重试参数。
# 它们不等于 Run Attempt 预算，也不改变结构化输出非法时的永久失败语义。
# AGENT_MODEL_TIMEOUT_SECONDS=60
# AGENT_MODEL_MAX_RETRIES=2

# scripts/dev.sh --real 默认读取仓库根目录 .env；也可以在命令行设置
# AGENT_ENV_FILE=/absolute/path/to/provider.env 指向其他文件。AGENT_ENV_FILE
# 属于启动脚本参数，不会进入 Settings 或业务快照。
